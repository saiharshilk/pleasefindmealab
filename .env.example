# Free key from https://openalex.org/settings/api ($1/day of credit, about 1,000 searches).
# Without it, everyone on the server's IP shares $0.10/day.
OPENALEX_API_KEY=
# Optional contact email OpenAlex can reach you at.
OPENALEX_MAILTO=
CACHE_PATH=cache.sqlite3
CACHE_TTL_SECONDS=86400
SEARCHES_PER_HOUR_PER_IP=30
